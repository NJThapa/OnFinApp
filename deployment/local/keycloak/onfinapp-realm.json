{
  "realm": "onfinapp",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "onfinapp-app",
      "name": "OnFinApp (Expo app)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "onfinapp://*",
        "exp://*",
        "http://localhost:19006/*",
        "http://localhost:8090/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "onfinapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "onfinapp-tests",
      "name": "OnFinApp contract tests (local only, password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "onfinapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@onfinapp.local",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ],
      "id": "00000000-0000-4000-8000-000000000001"
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@onfinapp.local",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demopass",
          "temporary": false
        }
      ]
    }
  ]
}
